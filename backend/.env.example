# =============================================================================
# AI Website Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All values shown below are defaults.
# =============================================================================

# --- AI Provider ---
# Supported: openai | anthropic | gemini | groq | openrouter
AI_PROVIDER=openai
API_KEY=your-api-key-here
MODEL_NAME=gpt-4o-mini

# Provider-specific model examples:
# OpenAI:      gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic:   claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Gemini:      gemini-2.0-flash, gemini-1.5-pro
# Groq:        llama-3.1-70b-versatile, mixtral-8x7b-32768
# OpenRouter:  openai/gpt-4o, anthropic/claude-3.5-sonnet

# --- LLM Parameters ---
TEMPERATURE=0.3
MAX_TOKENS=1024
TOP_P=0.9

# --- Embeddings ---
# Local sentence-transformers model (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Database ---
VECTOR_DB_PATH=./data/chromadb
COLLECTION_NAME=website_knowledge

# --- Knowledge Base ---
KNOWLEDGE_DIRECTORY=./knowledge

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- RAG ---
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# --- Conversation ---
CONVERSATION_WINDOW=10
CONVERSATION_TTL_SECONDS=3600
MAX_CONVERSATIONS=10000

# --- Security ---
ADMIN_API_KEY=replace-with-a-long-random-admin-key
RATE_LIMIT=30

# --- CORS ---
# Comma-separated origins. Add every website that embeds the widget.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Per-site chat keys ---
# Comma-separated 'site:token' pairs. When set, POST /chat requires a matching
# X-Site-Key header and each token is scoped to one site. Leave empty to keep
# /chat open (local/demo). These travel in the browser, so treat them as
# per-site identifiers, not secrets.
SITE_TOKENS=

# Keep false unless an authenticated administrator must ingest another local directory.
ALLOW_CUSTOM_INGEST_DIRECTORY=false
MAX_INGEST_FILE_BYTES=10000000
MAX_INGEST_FILES=1000
MAX_REQUEST_BYTES=100000
EXPOSE_API_DOCS=false

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Website Info ---
WEBSITE_NAME=Our Website
ASSISTANT_NAME=AI Assistant
